{
  "name": "@mehen/client",
  "version": "0.1.0",
  "private": true,
  "description": "A typed client for Mehen's machine and platform APIs: enrolment, workloads, runs, the relay, asks and platform mode, over WebCrypto and fetch.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./seal": "./src/seal.ts"
  },
  "files": ["src", "README.md"],
  "keywords": ["mehen", "credentials", "relay", "webcrypto", "cloudflare-workers"],
  "repository": { "type": "git", "url": "git+https://github.com/mehenai/mehen.git", "directory": "packages/client" },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@mehen/protocol": "workspace:*",
    "zod": "4.6.7"
  }
}
