{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // A template: the operator puts their own host names in routes before
  // deploying (docs/OPERATIONS.md, Your deployment's identity). Wrangler takes
  // the account from CLOUDFLARE_ACCOUNT_ID or the logged-in account.
  "name": "mehen-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "build": { "command": "bun scripts/build.ts", "cwd": "." },
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // The Worker must see every request so the www redirect fires before
    // the asset layer answers; it then serves the asset itself.
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "mehen-releases" }],
  "routes": [
    { "pattern": "mehen.dev", "custom_domain": true },
    { "pattern": "www.mehen.dev", "custom_domain": true }
  ],
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
